#!/bin/bash
#Установка тем
echo -e '\033[1;32m УСТАНАВЛИВАЕМ ТЕМЫ ДЛЯ GNOME И ОБОИ...\033[0m'

mkdir -p ~/.themes
cp ../themes/themes/* ~/.themes

for file in ~/.themes/*.tar.xz; do
	echo "Устанавливаем тему $file";
	tar xf "$file" -C ~/.themes
done

BG_DIR=/usr/share/backgrounds
THEMES_DIR=../themes

echo "Устанавливаем обои"

for name in Diesel MacBuntu-Wallpapers RocketFly; do
    sudo mkdir -p "$BG_DIR/$name"
    sudo cp -v "$THEMES_DIR/$name"/* "$BG_DIR/$name"/
done
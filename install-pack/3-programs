#!/bin/bash
#Обязательные программы
echo -e '\033[1;32m УСТАНАВЛИВАЕМ ОБЯЗАТЕЛЬНЫЕ ПРОГРАММЫ...\033[0m'
cat  << 'EOF'
# Описание программ

- google-chrome-stable — браузер Google Chrome. Нужен, если хотите использовать его вместо Firefox.
- gdebi — установка локальных `.deb`-файлов с автоматическим разрешением зависимостей.
- synaptic — графический менеджер пакетов для установки, удаления и поиска программ.
- mc — двухпанельный файловый менеджер для терминала.
- nemo — файловый менеджер из окружения Cinnamon; альтернатива штатному Nautilus.
- menulibre — редактор меню приложений и ярлыков.
- dconf-editor — редактор низкоуровневых настроек GNOME.
- net-tools — классические сетевые утилиты (`ifconfig`, `netstat` и др.).
- tilix — терминал с поддержкой тайлинга (разделения окна на панели).
- catfish — простой инструмент поиска файлов.
- gnome-tweaks — расширенные настройки GNOME (шрифты, темы, поведение окон).
- chrome-gnome-shell — коннектор для установки расширений GNOME через браузер.
- grub-customizer — настройка загрузчика GRUB2.
- timeshift — создание снимков системы и откат к рабочему состоянию.
- qbittorrent — лёгкий BitTorrent-клиент.
- vlc — универсальный медиаплеер, воспроизводит почти любые форматы.
EOF


# репа grub-customizer
sudo add-apt-repository -y ppa:danielrichter2007/grub-customizer

# Ключи для репы google-chrome
sudo mkdir -p /usr/share/keyrings
wget -qO- https://dl.google.com/linux/linux_signing_key.pub | sudo gpg --dearmor --yes -o /usr/share/keyrings/google-chrome.gpg
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" | sudo tee /etc/apt/sources.list.d/google-chrome.list


sudo apt update
sudo apt install -y google-chrome-stable gdebi synaptic mc nemo menulibre dconf-editor net-tools tilix \
catfish gnome-tweaks chrome-gnome-shell grub-customizer timeshift qbittorrent vlc 


#!/usr/bin/env bash
#
# Установка шрифта FiraCode Nerd Font в пользовательскую папку шрифтов
#

set -euo pipefail

# ---- Параметры скачивания шрифтов ----
FONT_VERSION="v3.5.1"
FONT_NAME="FiraCode"
FONT_ZIP="${FONT_NAME}.zip"
FONT_URL="https://github.com/ryanoasis/nerd-fonts/releases/download/${FONT_VERSION}/${FONT_ZIP}"
FONTS_DIR="${HOME}/.local/share/fonts"
TMP_DIR="$(mktemp -d)"


# ---- Параметры установки p10k и oh-my-zsh----
ZSH_THEME_NAME="powerlevel10k/powerlevel10k"
P10K_REPO="https://github.com/romkatv/powerlevel10k.git"
OMZ_INSTALL_URL="https://raw.github.com/robbyrussell/oh-my-zsh/master/tools/install.sh"
TARGET_USER="${SUDO_USER:-${USER}}"


# ---- Цветной вывод ----
info()  { printf '\033[1;34m[INFO]\033[0m  %s\n' "$*"; }
ok()    { printf '\033[1;32m[ OK ]\033[0m  %s\n' "$*"; }
warn()  { printf '\033[1;33m[WARN]\033[0m  %s\n' "$*"; }
err()   { printf '\033[1;31m[ERR ]\033[0m  %s\n' "$*" >&2; }

# ---- Очистка временных файлов при выходе ----
cleanup() {
    rm -rf "${TMP_DIR}"
}
trap cleanup EXIT

# ---- Проверка зависимостей. Программы curl unzip fc-cache git должны быть установлены ----
for cmd in curl unzip fc-cache git; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        err "Не найдена команда '${cmd}'. Установите её и повторите."
        exit 1
    fi
done

# ---- Скачивание ----
info "Скачивание шрифта ${FONT_ZIP} (${FONT_VERSION})..."
curl -fL --retry 3 --retry-delay 2 -o "${TMP_DIR}/${FONT_ZIP}" "${FONT_URL}"
ok "Архив скачан: ${TMP_DIR}/${FONT_ZIP}"

# ---- Распаковка ----
info "Распаковка архива..."
mkdir -p "${TMP_DIR}/extracted"
unzip -q "${TMP_DIR}/${FONT_ZIP}" -d "${TMP_DIR}/extracted"

# ---- Копирование шрифтов ----
info "Копирование шрифтов в ${FONTS_DIR}..."
mkdir -p "${FONTS_DIR}"

# Копируем только .ttf и .otf, чтобы не засорять папку README и лицензиями
find "${TMP_DIR}/extracted" -type f \( -iname '*.ttf' -o -iname '*.otf' \) \
    -exec cp -f {} "${FONTS_DIR}/" \;

ok "Скопировано файлов: $(find "${TMP_DIR}/extracted" -type f \( -iname '*.ttf' -o -iname '*.otf' \) | wc -l)"

# ---- Обновление кэша шрифтов ----
info "Обновление кэша шрифтов (fc-cache)..."
fc-cache -fv >/dev/null
ok "Кэш шрифтов обновлён."

# ---- Итог ----
info "Установленные шрифты FiraCode Nerd Font:"
fc-list | grep -i "FiraCode Nerd Font" | sed 's/^/    /' || warn "Шрифты не найдены в кэше — проверьте ${FONTS_DIR}"

echo
info "Устанавливаем шрифт FiraCode Nerd Font Regular 11 для терминала" 
gsettings set org.gnome.desktop.interface monospace-font-name 'FiraCode Nerd Font 11'

echo
ok "Готово!"


# Установка zsh, Oh My Zsh и темы powerlevel10k

# ---- 1. Установка zsh ----
if command -v zsh >/dev/null 2>&1; then
    ok "zsh уже установлен: $(zsh --version)"
else
    info "Установка zsh через apt..."
    sudo apt update -y
    sudo apt install -y zsh
    ok "zsh установлен: $(zsh --version)"
fi

# ---- 2. Смена оболочки по умолчанию ----
CURRENT_SHELL="$(getent passwd "${TARGET_USER}" | cut -d: -f7)"
if [ "${CURRENT_SHELL}" = "/bin/zsh" ] || [ "${CURRENT_SHELL}" = "/usr/bin/zsh" ]; then
    ok "Оболочка по умолчанию уже zsh (${CURRENT_SHELL})"
else
    info "Смена оболочки по умолчанию для пользователя '${TARGET_USER}' на /bin/zsh..."
    # chsh требует пароль пользователя, поэтому запускаем от имени владельца аккаунта
    sudo chsh -s /bin/zsh "${TARGET_USER}"
    ok "Оболочка по умолчанию изменена на /bin/zsh (вступит в силу после повторного входа)"
fi


# ---- 3. Установка Oh My Zsh ----
if [ -d "${HOME}/.oh-my-zsh" ]; then
    ok "Oh My Zsh уже установлен: ${HOME}/.oh-my-zsh"
else
    info "Установка Oh My Zsh..."
    # RUNZSH=no      - не запускать zsh после установки
    # CHSH=no        - не менять оболочку (мы уже сделали это выше)
    # KEEP_ZSHRC=yes - не перезаписывать существующий ~/.zshrc
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
        sh -c "$(curl -fsSL "${OMZ_INSTALL_URL}")"
    ok "Oh My Zsh установлен."
fi


# ---- 4. Клонирование powerlevel10k ----
ZSH_CUSTOM_DIR="${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}"
THEME_DIR="${ZSH_CUSTOM_DIR}/themes/powerlevel10k"

if [ -d "${THEME_DIR}/.git" ]; then
    ok "powerlevel10k уже склонирован: ${THEME_DIR}"
    info "Обновляем репозиторий темы..."
    git -C "${THEME_DIR}" pull --ff-only || warn "Не удалось обновить powerlevel10k (пропускаем)"
else
    info "Клонирование powerlevel10k в ${THEME_DIR}..."
    mkdir -p "${ZSH_CUSTOM_DIR}/themes"
    git clone --depth=1 "${P10K_REPO}" "${THEME_DIR}"
    ok "powerlevel10k установлен."
fi



# ---- 5. Настройка ZSH_THEME в ~/.zshrc ----
ZSHRC="${HOME}/.zshrc"

if [ ! -f "${ZSHRC}" ]; then
    warn "${ZSHRC} не найден. Создаю минимальный конфиг из шаблона Oh My Zsh..."
    cp "${HOME}/.oh-my-zsh/templates/zshrc.zsh-template" "${ZSHRC}"
fi


# ---- 6. Устанавливаем тему p10k и добавляем плагины в .zshrc 

# клонируем плагины
git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions


info "Установка ZSH_THEME=\"${ZSH_THEME_NAME}\" в ~/.zshrc..."
sed -i -E "s|^[[:space:]]*#?[[:space:]]*ZSH_THEME=.*|ZSH_THEME=\"${ZSH_THEME_NAME}\"|" "${ZSHRC}"

info "Добавляем плагины zsh-syntax-highlighting zsh-autosuggestions в ~/.zshrc..."
sed -i 's/^plugins=(.*)/plugins=(git zsh-syntax-highlighting zsh-autosuggestions)/' "${ZSHRC}"

info "Добавляем загрузку файла в текущую оболочку "
echo "[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh" >> "${ZSHRC}"


# ---- 6. Копирование готового конфига .p10k.zsh ----

P10K_CONFIG="${HOME}/.p10k.zsh"
# путь к  .p10k.zsh на диске
P10K_CONFIG_SRC="../config/oh-my-zsh/.p10k.zsh"

if [ ! -f "${P10K_CONFIG}" ]; then
    if [ -f "${P10K_CONFIG_SRC}" ]; then
        info "Копирование готового конфига .p10k.zsh..."
        cp "${P10K_CONFIG_SRC}" "${P10K_CONFIG}"
        ok "Конфиг .p10k.zsh установлен."
    else
        err "Исходный файл ${P10K_CONFIG_SRC} не найден! Мастер настройки запустится снова."
    fi
else
    ok "Конфиг .p10k.zsh уже существует, мастер не запустится."
fi

echo
ok "Установка терминала завершена!"
cat <<EOF
    Внимание! Настройки вступят в силу после перезагрузки.
    Для изменения внешнего вида p10k под себя запустите комаду: p10k configure
EOF


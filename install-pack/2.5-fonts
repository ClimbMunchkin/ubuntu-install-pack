#!/bin/bash
#Обязательные программы
echo -e '\033[1;32m УСТАНАВЛИВАЕМ ШРИФТЫ...\033[0m'
sudo apt update
sudo apt install -y ttf-mscorefonts-installer cabextract
mkdir ~/.fonts
wget -qO- http://plasmasturm.org/code/vistafonts-installer/vistafonts-installer | bash
cp ../fonts/* ~/.fonts
fc-cache -f -v
rm PowerPointViewer.exe